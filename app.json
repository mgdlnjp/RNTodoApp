{
  "expo": {
    "name": "RNTodoApp",
    "slug": "RNTodoApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OPLA accède à tes photos pour que tu puisses choisir ta photo de profil.",
          "cameraPermission": "OPLA utilise l’appareil photo pour prendre ta photo de profil."
        }
      ]
    ]
  }
}
